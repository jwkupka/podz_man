## Global options block                                  
{
	email {$EMAIL}
	ech ech.{$DOMAIN}
	acme_dns cloudflare {env.CLOUDFLARE_API_KEY}
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	#  acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
	#  debug

	## Socket activation
	default_bind fd/3 {
		protocols h1
	}
	default_bind fd/4 {
		protocols h1 h2
	}
	default_bind fdgram/5 {
		protocols h3
	}
}

## Services

mail.{$DOMAIN} {
	redir / /admin 301
	reverse_proxy stalwart:443 {
		transport http {
			proxy_protocol v2
			tls_insecure_skip_verify
		}
	}
}

vault.oci.{$DOMAIN} {
	reverse_proxy vaultwarden:80
}

prometheus.oci.{$DOMAIN} {
	reverse_proxy prometheus:9090
}

grafana.oci.{$DOMAIN} {
	reverse_proxy grafana:3000
}
