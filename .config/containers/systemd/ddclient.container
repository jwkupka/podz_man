[Unit]
Description=ddclient
After=network-online.target

[Container]
Image=ghcr.io/linuxserver/ddclient:latest
Volume=%h/etc/ddclient.conf:/config/ddclient.conf:Z
EnvironmentFile=%h/etc/vars.env
Secret=cloudflare_api_key,type=env,target=CLOUDFLARE_API_KEY
Timezone=local
#Network=podz.network
#Notify=true

[Service]
Restart=always

[Install]
WantedBy=default.target